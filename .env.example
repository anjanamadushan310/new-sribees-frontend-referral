# SRIBEES Partner Portal Environment Variables

# API Configuration
# Dev: leave unset (or /api/v1) — Vite proxies /api to VITE_PROXY_TARGET
# (see vite.config.ts), which defaults to https://api.sribeesonline.com.
# Prod: full backend origin, e.g. https://api.sribeesonline.com/api/v1
VITE_API_URL=/api/v1
